#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN &msc SCRL_UP>; // Corregido: sin coma intermedia
        tap-ms = <100>;
    };

    behaviors {
        caps_shift: caps_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        // Configuración para mitigar misclicks por deslizamiento (roll over)

        hrm: home_row_modifiers {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            label = "HRK";
            display-name = "HR_K";
            bindings = <
&trans          &trans            &trans        &trans  &trans  &trans       &tog 1           &trans     &trans          &trans     &trans   &trans    &trans
&kp TAB         &kp Q             &kp W         &kp E   &kp R   &kp T        &tog 0           &kp Y      &kp U           &kp I      &kp O    &kp P     &kp BACKSPACE
&kp CAPS        &kp A             &kp S         &kp D   &kp F   &kp G        &kp LEFT_ARROW   &kp H      &kp J           &kp K      &kp L    &kp SEMI  &kp SINGLE_QUOTE
&kp LEFT_SHIFT  &kp Z             &kp X         &kp C   &kp V   &kp B        &kp RIGHT_ARROW  &kp N      &kp M           &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_ALT
&kp C_MUTE      &kp LEFT_CONTROL  &kp LEFT_WIN  &mo 5   &mo 4   &kp ENTER    &tog 1           &kp SPACE  &kp LEFT_SHIFT  &mo 2      &none    &mo 7
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        Mac {
            label = "HRK";
            display-name = "HR_K";
            bindings = <
&trans          &trans        &trans            &trans  &trans  &trans       &tog 1           &trans     &trans          &trans     &trans   &trans    &trans
&kp TAB         &kp Q         &kp W             &kp E   &kp R   &kp T        &tog 0           &kp Y      &kp U           &kp I      &kp O    &kp P     &kp BACKSPACE
&kp CAPS        &kp A         &kp S             &kp D   &kp F   &kp G        &kp LEFT_ARROW   &kp H      &kp J           &kp K      &kp L    &kp SEMI  &kp SINGLE_QUOTE
&kp LEFT_SHIFT  &kp Z         &kp X             &kp C   &kp V   &kp B        &kp RIGHT_ARROW  &kp N      &kp M           &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_ALT
&kp C_MUTE      &kp LEFT_WIN  &kp LEFT_CONTROL  &mo 6   &mo 4   &kp ENTER    &tog 0           &kp SPACE  &kp LEFT_SHIFT  &mo 3      &none    &mo 7
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        OG_LMovement_Windows {
            bindings = <
&none   &none           &none           &none           &none            &none    &mmv MOVE_UP     &none  &none       &none          &none           &none  &none
&none   &none           &msc SCRL_LEFT  &kp UP_ARROW    &msc SCRL_RIGHT  &none    &mmv MOVE_DOWN   &none  &kp INSERT  &kp DELETE     &msc SCRL_UP    &none  &trans
&none   &kp LEFT_SHIFT  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none    &mmv MOVE_LEFT   &none  &kp HOME    &kp END        &msc SCRL_DOWN  &none  &trans
&trans  &kp LC(Z)       &kp LC(X)       &kp LC(C)       &kp LC(V)        &none    &mmv MOVE_RIGHT  &none  &kp PG_UP   &kp PAGE_DOWN  &none           &none  &trans
&none   &trans          &trans          &trans          &none            &none    &mkp LCLK        &none  &none       &trans         &none           &none
            >;

            display-name = "LAYER2";
            sensor-bindings = <&scroll_encoder>;
        };

        OG_LMovement_Mac {
            display-name = "LAYER2";
            bindings = <
&none   &none           &none           &none           &none            &none     &mmv MOVE_UP     &none  &none       &none          &none           &none  &none
&none   &none           &msc SCRL_LEFT  &kp UP_ARROW    &msc SCRL_RIGHT  &none     &mmv MOVE_DOWN   &none  &kp INSERT  &kp DELETE     &msc SCRL_UP    &none  &none
&none   &kp LEFT_SHIFT  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none     &mmv MOVE_LEFT   &none  &kp HOME    &kp END        &msc SCRL_DOWN  &none  &none
&trans  &kp LG(Z)       &kp LG(X)       &kp LG(C)       &kp LG(V)        &none     &mmv MOVE_RIGHT  &none  &kp PG_UP   &kp PAGE_DOWN  &none           &none  &trans
&none   &trans          &trans          &trans          &trans           &trans    &mkp LCLK        &none  &none       &trans         &none           &none
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        Signals {
            bindings = <
&trans  &trans           &trans  &trans    &trans         &trans         &trans  &trans            &trans                &trans             &trans                 &trans             &trans
&trans  &kp EXCLAMATION  &kp AT  &kp HASH  &kp DOLLAR     &kp PERCENT    &trans  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp DOUBLE_QUOTES  &kp RIGHT_PARENTHESIS  &kp EQUAL          &trans
&trans  &trans           &trans  &trans    &kp PIPE       &kp CARET      &trans  &kp AMPS          &kp LEFT_BRACE        &kp UNDERSCORE     &kp RIGHT_BRACE        &kp PLUS           &kp GRAVE
&trans  &trans           &trans  &trans    &kp BACKSLASH  &kp TILDE      &trans  &kp LEFT_BRACKET  &kp LESS_THAN         &kp MINUS          &kp GREATER_THAN       &kp RIGHT_BRACKET  &trans
&trans  &trans           &trans  &trans    &trans         &trans         &trans  &trans            &trans                &trans             &trans                 &trans
            >;
        };

        NumberWin {
            bindings = <
&none    &none  &none    &none   &none   &none     &none  &none  &none              &none          &none         &none       &none
&kp ESC  &none  &kp F12  &kp F7  &kp F8  &kp F9    &none  &none  &kp NUMBER_7       &kp NUMBER_8   &kp N9        &none       &none
&none    &none  &kp F11  &kp F4  &kp F5  &kp F6    &none  &none  &kp NUMBER_4       &kp NUMBER_5   &kp NUMBER_6  &kp N0      &none
&none    &none  &kp F10  &kp F1  &kp F2  &kp F3    &none  &none  &kp NUMBER_1       &kp NUMBER_2   &kp NUMBER_3  &kp PERIOD  &none
&none    &none  &none    &none   &none   &trans    &none  &none  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &none         &none
            >;
        };

        NumberMac {
            bindings = <
&none    &none  &none    &none   &none   &none     &none  &none         &none             &none              &none         &none       &none
&kp ESC  &none  &kp F12  &kp F7  &kp F8  &kp F9    &none  &none         &kp NUMBER_7      &kp NUMBER_8       &kp N9        &none       &none
&none    &none  &kp F11  &kp F4  &kp F5  &kp F6    &none  &none         &kp NUMBER_4      &kp NUMBER_5       &kp NUMBER_6  &kp N0      &none
&none    &none  &kp F10  &kp F1  &kp F2  &kp F3    &none  &none         &kp NUMBER_1      &kp NUMBER_2       &kp NUMBER_3  &kp PERIOD  &none
&none    &none  &none    &none   &none   &trans    &none  &kp LEFT_ALT  &kp LEFT_COMMAND  &kp RIGHT_CONTROL  &none         &none
            >;
        };

        HR_LConfig {
            display-name = "LAYER1";
            bindings = <
&none           &none            &none           &none            &none            &none           &mmv MOVE_UP     &none  &none  &none  &none  &none   &none
&bt BT_CLR_ALL  &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4    &mmv MOVE_DOWN   &none  &none  &none  &none  &none   &none
&none           &none            &none           &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &none           &mmv MOVE_LEFT   &none  &none  &none  &none  &none   &none
&none           &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &none           &mmv MOVE_RIGHT  &none  &none  &none  &none  &none   &none
&trans          &none            &none           &none            &none            &none           &mkp LCLK        &none  &none  &none  &none  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };
    };
};
